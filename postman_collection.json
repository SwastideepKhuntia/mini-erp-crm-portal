{
  "info": {
    "_postman_id": "erp-crm-operations-portal-collection-2026",
    "name": "Mini ERP + CRM Operations Portal API",
    "description": "Complete REST API collection for Mini ERP + CRM Operations Portal covering Auth (4 roles), Customer CRM, Product Inventory & Stock Logs, and Sales Challans with snapshot pricing and atomic stock transaction logic.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Authentication & Roles",
      "item": [
        {
          "name": "Login as Admin",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@company.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
